#include <unistd.h>
 
void	ft_put_digit(int n)
{
    char c;

    c = n + '0';
    write(1, &c, 1);
}

void    ft_put_three(int i, int j, int k)
{
    ft_put_digit(i);
    ft_put_digit(j);
    ft_put_digit(k);
}

void	ft_print_comb(void)
{
    int i;
    int j;
    int k;

    i = 0;
        while (i <= 7)
            {
                j = i + 1;
                while (j <= 8)
                {
                    k = j + 1;
                    while (k <= 9)
                    {
                        ft_put_three(i, j, k);
                        if(i != 7 || j != 8 || k != 9)
                        {
                            write(1, ", ", 2);
                        }
                        k++;
                    }
                    j++;
                }
                i++;
            }
}

#include <unistd.h>

void    ft_print_comb(void);
int main(void)
{
    ft_print_comb();
    write(1, "\n", 1);
    return (0);
}
