

int     ft_strcmp(char *s1, char *s2)
{
    int i;

    i = 0;
        while (s1[i] == s2[i] && s1[i] != '\0')
        {
            i++;
        }
    return (s1[i] - s2[i]);
}

int	ft_str_is_alpha(char *str)
{
    int i;

    i = 0;
        while(str[i] != '\0')
        {
            if(!((str[i] >= 'a' && str[i] <= 'z') || (str[i] >= 'A' && str[i] <= 'Z')))
             return (0);
            i++;
        }
        return (1);
}



int     ft_str_is_numeric(char *str)
{
    int i;

    i = 0;
        while(str[i] != '\0')
        {
            if(str[i] < '0' || str[i] > '9')
            return (0);
            i++;
        }
    return (1);
}





